{
  "info": {
    "name": "Instagram — DMs & Comments (Graph API)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Query Instagram messages and comments directly via the Meta Graph API.\n\nSETUP: paste each account's PAGE access token into the matching collection variable (token_shopzetu, token_zetu_men, ...). Instagram DMs/comments are read through the linked Facebook Page, so you use the PAGE token, not a user token.\n\nWorkflow: run 'DMs · list conversations', copy an id into {{conversation_id}}, then run 'DMs · messages in a conversation'. Same for comments via {{media_id}}."
  },
  "variable": [
    { "key": "graph", "value": "https://graph.facebook.com/v25.0" },
    { "key": "conversation_id", "value": "" },
    { "key": "media_id", "value": "" },
    { "key": "token_shopzetu", "value": "", "type": "secret" },
    { "key": "token_zetu_men", "value": "", "type": "secret" },
    { "key": "token_vivo_woman", "value": "", "type": "secret" },
    { "key": "token_safari_by_vivo", "value": "", "type": "secret" }
  ],
  "item": [
    {
      "name": "ShopZetu · @shopzetu",
      "description": "IG user 17841412308701394 via Page 115573226545299 (Shop Zetu). Set token_shopzetu.",
      "item": [
        {
          "name": "IG account info",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{graph}}/17841412308701394?fields=username,name,followers_count,media_count&access_token={{token_shopzetu}}",
              "host": ["{{graph}}"],
              "path": ["17841412308701394"],
              "query": [
                { "key": "fields", "value": "username,name,followers_count,media_count" },
                { "key": "access_token", "value": "{{token_shopzetu}}" }
              ]
            }
          }
        },
        {
          "name": "DMs · list conversations (recent)",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Newest-first by updated_time. message_count + participants are dropped and limit is small because this large account errors ('reduce the amount of data') otherwise. Copy an id into {{conversation_id}} for details. If it still errors, use fields=id&limit=3. NOTE: unaccepted 'Requests' (first-time DMs from non-followers) are NOT returned until accepted in the Instagram app.",
            "url": {
              "raw": "{{graph}}/115573226545299/conversations?platform=instagram&fields=id,updated_time&limit=5&access_token={{token_shopzetu}}",
              "host": ["{{graph}}"],
              "path": ["115573226545299", "conversations"],
              "query": [
                { "key": "platform", "value": "instagram" },
                { "key": "fields", "value": "id,updated_time" },
                { "key": "limit", "value": "5" },
                { "key": "access_token", "value": "{{token_shopzetu}}" }
              ]
            }
          }
        },
        {
          "name": "DMs · messages in a conversation",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Set {{conversation_id}} first. Messages are newest-first — filter created_time for today / last 2h by eye.",
            "url": {
              "raw": "{{graph}}/{{conversation_id}}?fields=participants,message_count,updated_time,messages.limit(15){id,created_time,from,to,message,attachments}&access_token={{token_shopzetu}}",
              "host": ["{{graph}}"],
              "path": ["{{conversation_id}}"],
              "query": [
                { "key": "fields", "value": "participants,message_count,updated_time,messages.limit(15){id,created_time,from,to,message,attachments}" },
                { "key": "access_token", "value": "{{token_shopzetu}}" }
              ]
            }
          }
        },
        {
          "name": "Comments · list recent media",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Copy a post id into {{media_id}}.",
            "url": {
              "raw": "{{graph}}/17841412308701394/media?fields=id,permalink,caption,timestamp,comments_count,like_count&limit=10&access_token={{token_shopzetu}}",
              "host": ["{{graph}}"],
              "path": ["17841412308701394", "media"],
              "query": [
                { "key": "fields", "value": "id,permalink,caption,timestamp,comments_count,like_count" },
                { "key": "limit", "value": "10" },
                { "key": "access_token", "value": "{{token_shopzetu}}" }
              ]
            }
          }
        },
        {
          "name": "Comments · on a media",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Set {{media_id}} first.",
            "url": {
              "raw": "{{graph}}/{{media_id}}/comments?fields=id,text,username,timestamp,like_count,replies{id,text,username,timestamp}&access_token={{token_shopzetu}}",
              "host": ["{{graph}}"],
              "path": ["{{media_id}}", "comments"],
              "query": [
                { "key": "fields", "value": "id,text,username,timestamp,like_count,replies{id,text,username,timestamp}" },
                { "key": "access_token", "value": "{{token_shopzetu}}" }
              ]
            }
          }
        },
        {
          "name": "Diagnostics · webhook subscription",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{graph}}/115573226545299/subscribed_apps?access_token={{token_shopzetu}}",
              "host": ["{{graph}}"],
              "path": ["115573226545299", "subscribed_apps"],
              "query": [{ "key": "access_token", "value": "{{token_shopzetu}}" }]
            }
          }
        }
      ]
    },
